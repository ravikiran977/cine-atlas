# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="replace-with-a-long-random-secret-before-enabling-auth"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:3000"
# For local HTTP development use false/lax. Production requires true; `none` also requires true.
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
PORT=5000
TMDB_API_KEY=""
# Obtain this server-only v3 key from https://www.themoviedb.org/settings/api
